  "IsEnabled": true,
  "LogIncomingData": true,
  "IsConnected": true,
  "BaudRate": 115200,
  "DtrEnable": false,
  "RtsEnable": false,
  "EditorExpanded": true,
  "Name": "Custom Serial device",
  "Description": "Serial device",
  "LastErrorDate": "2026-02-01T13:35:43.8416087+03:00",
  "LastErrorMessage": null,
  "IsFreezed": false,
  "SettingsBuilder": {
    "Settings": [],
    "IsEditMode": false
  },
  "OnConnectMessage": {
    "Expression": ""
  },
  "OnDisconnectMessage": {
    "Expression": ""
  },
  "UpdateMessages": [
    {
      "Message": {
        "Expression": "'SH;1;' + truncate([SpeedKmh]) + ';' + truncate([Rpms]) + ';' + truncate([CarSettings_CurrentDisplayedRPMPercent]) + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 30
    },
    {
      "Message": {
        "Expression": "'SH;2;' + [Gear] + ';' + truncate([CarSettings_RPMShiftLight1]) + ';' + truncate([CarSettings_RPMShiftLight2]) + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'SH;3;' + [ABSLevel] + ';' + [ABSActive] + ';' + [TCLevel] + ';' + [TCActive] + ';' + max([Handbrake], if([GameRawData.TruckValues.CurrentValues.MotorValues.BrakeValues.ParkingBrake],1, 0)) + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'SH;4;' + [TurnIndicatorLeft] + ';' + [TurnIndicatorRight] + ';' + if([GameRawData.TruckValues.CurrentValues.LightsValues.BeamLow], 1, 0) + ';' + if([GameRawData.TruckValues.CurrentValues.LightsValues.BeamHigh], 1, 0) + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    },
    {
      "Message": {
        "Expression": "'SH;5;' + truncate([FuelPercent]) + ';' + [CarSettings_FuelAlertActive] + '\\n'"
      },
      "IsEnabled": true,
      "MaximumFrequency": 0
    }
  ]
}